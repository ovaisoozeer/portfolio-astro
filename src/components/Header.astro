---
import { site } from '../data/site';

const links = [
  { label: 'Services', href: '/#about' },
  { label: 'Portfolio', href: '/projects' },
  { label: 'Free Stuff', href: '/free-stuff' },
  { label: 'Career', href: '/career' },
  { label: 'Contact', href: '/contact' },
];
---

<header class="header">
  <nav class="container nav" aria-label="Main">
    <a href="/" class="brand">{site.siteName}</a>
    <ul class="links">
      {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
    <button id="theme-toggle" class="toggle" type="button" aria-label="Toggle dark mode">
      <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
      <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
      </svg>
    </button>
  </nav>
</header>

<script>
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 4rem;
  }

  .brand {
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    margin-right: auto;
  }

  .links {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .links a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .links a:hover {
    color: var(--text);
  }

  .toggle {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }

  :global([data-theme='dark']) .sun,
  :global([data-theme='light']) .moon {
    display: none;
  }

  @media (max-width: 640px) {
    .links {
      display: none;
    }
  }
</style>
