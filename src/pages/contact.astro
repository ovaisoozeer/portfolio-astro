---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title="Contact" description={`Get in touch with ${site.siteName}.`}>
  <section class="section container">
    <h1>Contact</h1>
    <p class="intro">Reach out for a virtual or IRL (preferred) coffee and chat.</p>
    <div class="actions">
      <a class="btn btn-primary" href={`mailto:${site.email}`}>{site.email}</a>
      <a class="btn" href={site.phone.href}>{site.phone.display}</a>
      <a class="btn" href={site.calendarUrl}>Book a meeting</a>
      {site.resumeUrl && <a class="btn" href={site.resumeUrl}>Download CV</a>}
    </div>
  </section>
</BaseLayout>

<style>
  h1 {
    font-size: clamp(2.2rem, 6vw, 3.2rem);
    margin: 0;
  }

  .intro {
    max-width: 34rem;
    margin: 0.5rem 0 2rem;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
