---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container inner">
    <p>© {year} {site.name}. Built with <a href="https://astro.build">Astro</a>.</p>
    <ul class="socials">
      {site.socials.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
    </ul>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9rem;
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 2rem;
  }

  p {
    margin: 0;
  }

  .socials {
    display: flex;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .socials a {
    color: var(--muted);
  }

  .socials a:hover {
    color: var(--link);
  }
</style>
